{
  "name": "pages-visual-editor-starter",
  "version": "0.0.0",
  "description": "An example repository to help users get started with Visual Editor Section Libraries on Yext Pages",
  "author": "sprumo@yext.com",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "dev": "SECTION_LIBRARY_REVISION_ID=local pages dev",
    "prod": "pages prod",
    "build": "pages build",
    "lint": "oxlint --react-plugin --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "validate": "yextve validate",
    "deploy": "yextve deploy",
    "convert-template": "yextve convert-template --apply --delete-source",
    "add-directory-locator": "yextve add-directory-locator"
  },
  "engines": {
    "node": ">=20.18.2"
  },
  "dependencies": {
    "@puckeditor/core": "0.22.2",
    "@types/node": "^20.12.3",
    "@yext/search-headless-react": "^2.7.1",
    "@yext/search-ui-react": "^3.0.1",
    "awesome-phonenumber": "^7.8.0",
    "lucide-react": "^0.414.0",
    "mapbox-gl": "^3.20.0",
    "react": "^18.2.0",
    "react-collapsed": "^4.1.2",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.5.2",
    "react-icons": "^5.2.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.2.1",
    "@yext/pages": "1.3.2",
    "@yext/pages-components": "2.2.0",
    "@yext/visual-editor": "https://raw.githubusercontent.com/briantstephan/experimental-packs/main/visual-editor/prod/yext-visual-editor-1.4.4-section-library-29ff715.tgz",
    "autoprefixer": "^10.4.8",
    "oxlint": "1.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.21"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
