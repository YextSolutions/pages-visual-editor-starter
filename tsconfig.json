{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@yext/pages": ["./node_modules/@yext/pages/dist/types/src/index.d.ts"]
    }
  },
  "include": ["src", "global.d.ts", "theme.config.ts"]
}
