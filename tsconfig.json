{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "Bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "esnext",
    "types": ["vite/client"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src", "global.d.ts", "theme.config.ts"]
}
