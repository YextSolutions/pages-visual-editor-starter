{
  "compilerOptions": {
    "target": "ESNext",
    "strict": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts",
    "global.d.ts",
    "theme.config.ts"
  ]
}
